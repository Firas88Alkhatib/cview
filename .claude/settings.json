{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bunx vitest run:*)",
      "Bash(bunx playwright test:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Read(./bun.lock)",
      "Read(./.nuxt/**)",
      "Read(./.output/**)",
      "Read(./.nitro/**)",
      "Read(./.data/**)",
      "Read(./.cache/**)",
      "Read(./test-results/**)",
      "Read(./playwright-report/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)"
    ]
  }
}
