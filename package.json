    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^14.4.0",
    "elysia": "^1.4.32",
    "motion-v": "^2.13.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
